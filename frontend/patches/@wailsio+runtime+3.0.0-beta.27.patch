+    if (typeof window !== 'undefined' && window.harmonyBridge) {
+        return window.harmonyBridge.invoke('clipboard.readText', '{}')
+            .then(resp => { const r = JSON.parse(resp); if (!r.success) throw new Error(r.error?.message || 'read failed'); return r.data || ''; });
+    }
     return call(ClipboardText);
 }
