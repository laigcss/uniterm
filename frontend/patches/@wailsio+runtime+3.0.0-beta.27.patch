  * @return A Promise that resolves when the operation is successful.
  */
 export function SetText(text) {
+    // HarmonyOS: route through JSBridge (Go subprocess cannot access system clipboard)
+    if (typeof window !== 'undefined' && window.harmonyBridge) {
+        return window.harmonyBridge.invoke('clipboard.writeText', JSON.stringify({ text }))
+            .then(resp => { const r = JSON.parse(resp); if (!r.success) throw new Error(r.error?.message || 'write failed'); return r.data; });
+    }
     return call(ClipboardSetText, { text });
 }
 /**
@@ -26,5 +31,10 @@ export function SetText(text) {
