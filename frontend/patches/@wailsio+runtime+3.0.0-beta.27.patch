 export function SetText(text) {
+    // HarmonyOS: route through JSBridge (Go subprocess cannot access system clipboard).
+    // __unitermBridgeInvoke is the callback-mode entry (ArkWeb asyncMethodList
+    // Promise results are broken); registered by src/utils/harmonyos-bridge.ts.
+    if (typeof window !== 'undefined' && window.harmonyBridge) {
